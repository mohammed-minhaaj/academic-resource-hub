PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/academic_resource_db
SESSION_SECRET=supersecret_session_key_replace_in_production
JWT_SECRET=supersecret_jwt_key_replace_in_production
COOKIE_SECRET=supersecret_cookie_key_replace_in_production

# Storage Mode: 'local' (disk storage) or 's3' (MinIO / AWS S3)
STORAGE_TYPE=local

# AWS S3 / MinIO Configuration (for academic resource uploads)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=academic-resource-sharing-bucket
S3_ENDPOINT=http://localhost:9000
