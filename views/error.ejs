<% layout('layouts/boilerplate') %>

<div class="row">
    <div class="col-md-8 offset-md-2 my-5">
        <div class="card border-danger shadow-sm">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0">Error <%= err.statusCode || 500 %></h4>
            </div>
            <div class="card-body">
                <h5 class="card-title text-danger"><%= err.message || 'An unexpected error occurred.' %></h5>
                <% if (process.env.NODE_ENV !== 'production' && err.stack) { %>
                    <hr>
                    <p class="text-muted fw-bold">Stack Trace (Development Mode):</p>
                    <pre class="bg-light p-3 border rounded small overflow-auto" style="max-height: 300px;"><code><%= err.stack %></code></pre>
                <% } %>
                <div class="mt-4">
                    <a href="/" class="btn btn-outline-secondary">&larr; Return to Home</a>
                </div>
            </div>
        </div>
    </div>
</div>
