<% layout('layouts/boilerplate') %>

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-4 p-md-5">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                    <div>
                        <% if (resource.branch === 'ALL' || resource.branch === 'ADMIN') { %>
                            <span class="badge bg-danger me-1">ALL DEPTS</span>
                        <% } else { %>
                            <span class="badge bg-primary me-1"><%= resource.branch %></span>
                        <% } %>
                        <span class="badge bg-secondary me-1"><%= resource.resourceType %></span>
                        <% if (resource.status === 'APPROVED') { %>
                            <span class="badge bg-success">Verified & Approved</span>
                        <% } else if (resource.status === 'PENDING') { %>
                            <span class="badge bg-warning text-dark">Pending Verification</span>
                        <% } else { %>
                            <span class="badge bg-danger">Rejected</span>
                        <% } %>
                    </div>
                    <small class="text-muted">
                        Uploaded on <%= new Date(resource.createdAt).toLocaleDateString() %>
                    </small>
                </div>

                <h2 class="fw-bold text-dark mb-2"><%= resource.title %></h2>
                <h5 class="text-secondary mb-4">Subject: <span class="text-dark"><%= resource.subject %></span></h5>

                <% if (resource.semester) { %>
                    <p class="mb-3"><strong>Target Semester:</strong> Semester <%= resource.semester %></p>
                <% } %>

                <h6 class="fw-bold text-uppercase text-muted small mt-4">Description</h6>
                <div class="p-3 bg-light rounded-3 mb-4">
                    <p class="card-text mb-0" style="white-space: pre-line;"><%= resource.description %></p>
                </div>

                <!-- File Access Card -->
                <div class="card border-primary-subtle bg-light-subtle p-3 mb-4">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                        <div>
                            <h6 class="mb-1 fw-bold text-primary">Attached Document</h6>
                            <small class="text-muted">Stored securely on Cloud S3 Storage</small>
                        </div>
                        <a href="<%= resource.fileUrl %>" target="_blank" rel="noopener noreferrer" class="btn btn-success fw-semibold">
                            &#x2B07; Download / View Document
                        </a>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                    <div class="d-flex align-items-center gap-3">
                        <div class="text-muted small">
                            Uploaded by: <strong><%= resource.uploader ? resource.uploader.email : 'Unknown' %></strong>
                        </div>
                        <% if (currUser && resource.uploader && resource.uploader._id.toString() !== currUser._id.toString()) { %>
                            <form action="/resources/<%= resource._id %>/report" method="POST" class="d-inline" onsubmit="return confirm('Report this resource as inappropriate or misleading to admins?');">
                                <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-2" title="Report resource to admins">
                                    &#9888; Report
                                </button>
                            </form>
                        <% } %>
                    </div>

                    <!-- Owner Controls (Edit and Delete) -->
                    <% if (currUser && resource.uploader && (resource.uploader._id.toString() === currUser._id.toString() || currUser.role === 'ADMIN')) { %>
                        <div class="d-flex gap-2">
                            <a href="/resources/<%= resource._id %>/edit" class="btn btn-outline-warning btn-sm">Edit</a>
                            <form action="/resources/<%= resource._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Are you sure you want to delete this resource?');" class="d-inline">
                                <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                            </form>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>

        <div>
            <a href="/resources" class="btn btn-link text-decoration-none">&larr; Back to Resource Hub</a>
        </div>
    </div>
</div>
