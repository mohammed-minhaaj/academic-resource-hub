<% layout('layouts/boilerplate') %>

<!-- Branch Dashboard Header -->
<div class="row align-items-center mb-4">
    <div class="col-md-7">
        <h2 class="fw-bold mb-1 d-flex align-items-center gap-2">
            <% if (currUser && currUser.role === 'ADMIN' && !currentBranch) { %>
                <span>Academic Resources:</span>
                <span class="badge bg-secondary fs-6">All Branches</span>
            <% } else if (currentBranch) { %>
                <span>Branch Dashboard:</span>
                <span class="badge badge-branch fs-6"><%= currentBranch %></span>
            <% } else { %>
                <span>Academic Resources:</span>
                <span class="badge bg-secondary fs-6">All Branches</span>
            <% } %>
        </h2>
        <p class="text-muted mb-0">
            <% if (currUser && currUser.role === 'ADMIN') { %>
                Displaying verified academic resources across all engineering departments.
            <% } else if (currUser && currUser.branch) { %>
                Displaying curated academic resources for your department (<strong class="text-dark"><%= currUser.branch %></strong>).
            <% } else { %>
                Discover verified study materials, lecture notes, syllabus copies, and past exam papers.
            <% } %>
        </p>
    </div>
    <div class="col-md-5 text-md-end mt-3 mt-md-0">
        <a href="/resources/new" class="btn btn-primary shadow-sm fw-semibold me-2">+ Upload Resource</a>
        <% if (currUser) { %>
            <a href="/resources/my-resources" class="btn btn-outline-secondary shadow-sm">My Uploads</a>
        <% } %>
    </div>
</div>

<!-- Search & Category Filter Toolbar -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form action="/resources" method="GET" class="row g-2 align-items-center">
            <div class="col-md-5">
                <input
                    type="text"
                    name="subject"
                    class="form-control"
                    placeholder="Search by subject (e.g. Operating Systems, DBMS)"
                    value="<%= searchQuery || '' %>"
                >
            </div>
            <div class="col-md-4">
                <select name="resourceType" class="form-select">
                    <option value="">All Categories</option>
                    <option value="NOTES" <%= selectedType === 'NOTES' ? 'selected' : '' %>>Lecture Notes</option>
                    <option value="PYQ" <%= selectedType === 'PYQ' ? 'selected' : '' %>>Previous Year Questions (PYQ)</option>
                    <option value="SYLLABUS" <%= selectedType === 'SYLLABUS' ? 'selected' : '' %>>Syllabus</option>
                    <option value="ASSIGNMENT" <%= selectedType === 'ASSIGNMENT' ? 'selected' : '' %>>Assignment Solutions</option>
                    <option value="LAB_MANUAL" <%= selectedType === 'LAB_MANUAL' ? 'selected' : '' %>>Lab Manuals</option>
                    <option value="REFERENCE_BOOK" <%= selectedType === 'REFERENCE_BOOK' ? 'selected' : '' %>>Reference Books</option>
                    <option value="OTHER" <%= selectedType === 'OTHER' ? 'selected' : '' %>>Other</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-dark flex-grow-1 fw-semibold">Filter</button>
                <a href="/resources" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Resource Cards Grid -->
<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    <% if (resources && resources.length > 0) { %>
        <% for (let resource of resources) { %>
            <div class="col">
                <div class="card h-100 shadow-sm resource-card" data-type="<%= resource.resourceType %>">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <% if (resource.branch === 'ALL' || resource.branch === 'ADMIN') { %>
                                <span class="badge bg-danger">ALL DEPTS</span>
                            <% } else { %>
                                <span class="badge badge-branch"><%= resource.branch %></span>
                            <% } %>
                            <span class="badge badge-type"><%= resource.resourceType %></span>
                        </div>
                        <h5 class="card-title mb-1 text-truncate" title="<%= resource.title %>">
                            <a href="/resources/<%= resource._id %>" class="text-decoration-none">
                                <%= resource.title %>
                            </a>
                        </h5>
                        <h6 class="card-subtitle mb-2"><%= resource.subject %></h6>
                        <p class="card-text flex-grow-1">
                            <%= resource.description %>
                        </p>
                        <hr class="my-2 opacity-25">
                        <div class="d-flex justify-content-between align-items-center pt-2 mt-auto">
                            <small class="text-muted">
                                By: <%= resource.uploader ? resource.uploader.email.split('@')[0] : 'Student' %>
                            </small>
                            <div class="d-flex gap-1">
                                <a href="<%= resource.fileUrl %>" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-success py-1 px-2" title="Download Document">
                                    &#x2B07;
                                </a>
                                <a href="/resources/<%= resource._id %>" class="btn btn-sm btn-primary py-1 px-2">
                                    View &rarr;
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        <% } %>
    <% } else { %>
        <div class="col-12">
            <div class="alert alert-light text-center py-5 border shadow-sm rounded-3">
                <h4 class="alert-heading text-secondary fw-bold">No approved resources found</h4>
                <p class="mb-3 text-muted">No verified resources are available for this filter yet. Be the first to share your notes!</p>
                <a href="/resources/new" class="btn btn-primary px-4 fw-semibold">+ Upload Now</a>
            </div>
        </div>
    <% } %>
</div>
