<% layout('layouts/boilerplate') %>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">My Uploaded Resources</h2>
        <p class="text-muted mb-0">Track verification status and manage resources you have contributed.</p>
    </div>
    <a href="/resources/new" class="btn btn-primary shadow-sm">+ Upload New Resource</a>
</div>

<% if (resources && resources.length > 0) { %>
    <div class="table-responsive bg-white rounded-3 shadow-sm p-3">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col">Title</th>
                    <th scope="col">Subject</th>
                    <th scope="col">Type</th>
                    <th scope="col">Status</th>
                    <th scope="col">Uploaded</th>
                    <th scope="col" class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                <% for (let resource of resources) { %>
                    <tr>
                        <td>
                            <a href="/resources/<%= resource._id %>" class="fw-bold text-decoration-none text-dark">
                                <%= resource.title %>
                            </a>
                        </td>
                        <td><%= resource.subject %></td>
                        <td><span class="badge bg-secondary"><%= resource.resourceType %></span></td>
                        <td>
                            <% if (resource.status === 'APPROVED') { %>
                                <span class="badge bg-success">Approved</span>
                            <% } else if (resource.status === 'PENDING') { %>
                                <span class="badge bg-warning text-dark">Pending</span>
                            <% } else { %>
                                <span class="badge bg-danger">Rejected</span>
                            <% } %>
                        </td>
                        <td class="small text-muted"><%= new Date(resource.createdAt).toLocaleDateString() %></td>
                        <td class="text-end">
                            <a href="/resources/<%= resource._id %>" class="btn btn-sm btn-outline-info me-1">View</a>
                            <a href="/resources/<%= resource._id %>/edit" class="btn btn-sm btn-outline-warning me-1">Edit</a>
                            <form action="/resources/<%= resource._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Are you sure you want to delete this resource?');" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
<% } else { %>
    <div class="alert alert-light text-center py-5 border shadow-sm rounded">
        <h4 class="alert-heading text-secondary">You haven't uploaded any resources yet</h4>
        <p class="mb-3 text-muted">Contribute lecture notes, previous question papers, or syllabus documents.</p>
        <a href="/resources/new" class="btn btn-primary">Upload your first resource</a>
    </div>
<% } %>
