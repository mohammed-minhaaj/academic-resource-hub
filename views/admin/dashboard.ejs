<% layout('layouts/boilerplate') %>

<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <h2 class="fw-bold mb-1">Admin Moderation Dashboard</h2>
        <p class="text-muted mb-0">Review pending uploads, verify academic resources, and manage reported content.</p>
    </div>
    <div class="col-md-4 text-md-end mt-3 mt-md-0">
        <span class="badge bg-danger fs-6 p-2">Administrator Access</span>
    </div>
</div>

<!-- KPI Stats Overview Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm text-center p-3">
            <h6 class="text-muted small text-uppercase">Total Uploads</h6>
            <h3 class="fw-bold mb-0 text-dark"><%= stats.total %></h3>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm text-center p-3 bg-warning-subtle">
            <h6 class="text-warning-emphasis small text-uppercase fw-bold">Pending Review</h6>
            <h3 class="fw-bold mb-0 text-warning-emphasis"><%= stats.pending %></h3>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm text-center p-3 bg-success-subtle">
            <h6 class="text-success-emphasis small text-uppercase fw-bold">Approved</h6>
            <h3 class="fw-bold mb-0 text-success-emphasis"><%= stats.approved %></h3>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm text-center p-3 bg-danger-subtle">
            <h6 class="text-danger-emphasis small text-uppercase fw-bold">Flagged / Reported</h6>
            <h3 class="fw-bold mb-0 text-danger-emphasis"><%= stats.reported %></h3>
        </div>
    </div>
</div>

<!-- Filter Tabs and Branch Selector -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <form action="/admin/dashboard" method="GET" class="row g-3 align-items-center">
            <div class="col-md-5">
                <div class="btn-group w-100" role="group">
                    <a href="/admin/dashboard" class="btn btn-outline-secondary btn-sm <%= filterStatus === 'ALL' && !filterReported ? 'active' : '' %>">All</a>
                    <a href="/admin/dashboard?status=PENDING" class="btn btn-outline-warning btn-sm <%= filterStatus === 'PENDING' ? 'active' : '' %>">Pending (<%= stats.pending %>)</a>
                    <a href="/admin/dashboard?status=APPROVED" class="btn btn-outline-success btn-sm <%= filterStatus === 'APPROVED' ? 'active' : '' %>">Approved (<%= stats.approved %>)</a>
                    <a href="/admin/dashboard?status=REJECTED" class="btn btn-outline-danger btn-sm <%= filterStatus === 'REJECTED' ? 'active' : '' %>">Rejected (<%= stats.rejected %>)</a>
                    <a href="/admin/dashboard?reported=true" class="btn btn-outline-danger btn-sm <%= filterReported ? 'active' : '' %>">Reported (<%= stats.reported %>)</a>
                </div>
            </div>

            <div class="col-md-4">
                <input
                    type="text"
                    name="branch"
                    class="form-control form-control-sm"
                    placeholder="Filter by branch (e.g. CSE, CSM, ECE)"
                    value="<%= filterBranch || '' %>"
                >
            </div>

            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-dark btn-sm flex-grow-1">Filter</button>
                <a href="/admin/dashboard" class="btn btn-outline-secondary btn-sm">Clear</a>
            </div>
        </form>
    </div>
</div>

<!-- Moderation Table -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col" class="ps-3">Resource & Subject</th>
                        <th scope="col">Branch & Type</th>
                        <th scope="col">Uploader</th>
                        <th scope="col">Status</th>
                        <th scope="col">Reports</th>
                        <th scope="col">File</th>
                        <th scope="col" class="text-end pe-3">Moderation Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (resources && resources.length > 0) { %>
                        <% for (let resource of resources) { %>
                            <tr class="<%= resource.reportCount > 0 ? 'table-warning' : '' %>">
                                <td class="ps-3">
                                    <a href="/resources/<%= resource._id %>" class="fw-bold text-decoration-none text-dark d-block text-truncate" style="max-width: 260px;" title="<%= resource.title %>">
                                        <%= resource.title %>
                                    </a>
                                    <small class="text-muted"><%= resource.subject %></small>
                                </td>
                                <td>
                                    <span class="badge bg-info text-dark"><%= resource.branch %></span>
                                    <span class="badge bg-secondary"><%= resource.resourceType %></span>
                                </td>
                                <td class="small">
                                    <%= resource.uploader ? resource.uploader.email : 'Unknown' %>
                                </td>
                                <td>
                                    <% if (resource.status === 'APPROVED') { %>
                                        <span class="badge bg-success">Approved</span>
                                    <% } else if (resource.status === 'PENDING') { %>
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    <% } else { %>
                                        <span class="badge bg-danger">Rejected</span>
                                    <% } %>
                                </td>
                                <td>
                                    <% if (resource.reportCount > 0) { %>
                                        <span class="badge bg-danger" title="Reported by students">&#9888; <%= resource.reportCount %></span>
                                    <% } else { %>
                                        <span class="text-muted small">0</span>
                                    <% } %>
                                </td>
                                <td>
                                    <a href="<%= resource.fileUrl %>" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary py-0 px-2">
                                        Inspect
                                    </a>
                                </td>
                                <td class="text-end pe-3">
                                    <!-- Moderate: Approve -->
                                    <% if (resource.status !== 'APPROVED') { %>
                                        <form action="/admin/resources/<%= resource._id %>/status?_method=PATCH" method="POST" class="d-inline">
                                            <input type="hidden" name="status" value="APPROVED">
                                            <button type="submit" class="btn btn-sm btn-success py-1 px-2" title="Approve Resource">
                                                Approve
                                            </button>
                                        </form>
                                    <% } %>

                                    <!-- Moderate: Reject -->
                                    <% if (resource.status !== 'REJECTED') { %>
                                        <form action="/admin/resources/<%= resource._id %>/status?_method=PATCH" method="POST" class="d-inline">
                                            <input type="hidden" name="status" value="REJECTED">
                                            <button type="submit" class="btn btn-sm btn-warning py-1 px-2" title="Reject Resource">
                                                Reject
                                            </button>
                                        </form>
                                    <% } %>

                                    <!-- Admin Delete -->
                                    <form action="/admin/resources/<%= resource._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this resource permanently from S3 and Database?');" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-danger py-1 px-2" title="Permanently Delete">
                                            Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        <% } %>
                    <% } else { %>
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                No resources match the current filter criteria.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>
