<% if (success && success.length) { %>
    <div class="alert alert-success alert-dismissible fade show shadow-sm d-flex align-items-center justify-content-between my-3" role="alert">
        <div>
            <strong>Success:</strong> <%= success %>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>

<% if (error && error.length) { %>
    <div class="alert alert-danger alert-dismissible fade show shadow-sm d-flex align-items-center justify-content-between my-3" role="alert">
        <div>
            <strong>Error:</strong> <%= error %>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>
