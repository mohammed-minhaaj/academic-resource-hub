                        <span class="text-white-50"><%= currUser.email ? currUser.email.split('@')[0] : 'User' %></span>
                    </li>
                    <li class="nav-item">
                        <form action="/logout" method="POST" class="d-inline m-0">
                            <button class="btn btn-sm btn-outline-danger px-3" type="submit">Logout</button>
                        </form>
                    </li>
                <% } %>
            </ul>
        </div>
